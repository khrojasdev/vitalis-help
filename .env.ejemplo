# Copie este archivo con el nombre .env (en la misma carpeta) y complete sus datos.
# El archivo .env NO se comparte, NO se sube a GitHub y NO se envía por chat.

# Cliente y clave de la API CIE-11 (https://icd.who.int/icdapi → View API access key)
ICD_CLIENT_ID=pegue_aqui_su_client_id
ICD_CLIENT_SECRET=pegue_aqui_su_client_secret

# Versión de la CIE-11 MMS e idioma (2026-01 incluye español)
ICD_RELEASE=2026-01
ICD_IDIOMA=es

# Servidor terminológico para verificar snomed.js (Snowstorm con FHIR)
SNOMED_FHIR=http://localhost:8080/fhir

# Solo si la clínica instala la API de la OMS en sus propios servidores (Docker):
# ICD_API_BASE=http://localhost:8382
# ICD_SIN_TOKEN=1

# Solo si publica servidor.py en internet: páginas que pueden consultarlo (separadas por coma)
# CORS_ORIGINS=https://khrojasdev.github.io

# Opcional: IA para repartir el «Dictado de la atención completa» en los campos de la ficha.
# Sin esta clave se usan las reglas de dictado.js. Clave en https://platform.claude.com (API keys).
# ANTHROPIC_API_KEY=pegue_aqui_su_clave
# IA_MODELO=claude-haiku-5-5
